{
  "name": "long-view-invest",
  "version": "0.1.0",
  "private": true,
  "description": "Long-View Investment App: a single-user PWA that runs a 30-year core-satellite portfolio on written rules (see docs/PRD.md).",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:sources": "tsx scripts/check_sources.ts",
    "check:supabase": "tsx scripts/check_supabase.ts",
    "test": "tsx --test --test-reporter=spec scripts/lib/*.test.ts scripts/lib/*/*.test.ts tests/db/*.test.ts lib/*.test.ts lib/*/*.test.ts",
    "typecheck": "tsc -p scripts && tsc -p tests && tsc --noEmit -p .",
    "test:e2e": "bash tests/e2e/run.sh",
    "nightly": "tsx scripts/nightly.ts",
    "notify": "tsx scripts/notify.ts",
    "vapid-keys": "tsx scripts/vapid_keys.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "fflate": "^0.8.3",
    "playwright-core": "1.56.1",
    "supabase": "^2.120.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "echarts": "^6.1.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7"
  }
}
