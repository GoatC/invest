// Build settings of the iOS shell that are the same for everyone. What is Hugo's own (the site's
// host, his Apple team, the app's identifier) is in Local.xcconfig beside this file, which git
// ignores: ios/setup.sh writes it (docs/ios-app.md). The repository is public; none of it belongs here.

// Stand-ins, so the project builds unsigned without Local.xcconfig (GitHub Actions does).
SITE_HOST =
BUNDLE_ID = app.longview.shell.unset
DEVELOPMENT_TEAM =

MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

#include? "Local.xcconfig"
