# Copy this file to .env.local and fill in your own values. .env.local is git-ignored.
# 把這個檔案複製成 .env.local，再填入你自己的值。.env.local 不會被 git 上傳。
# This repo is public: never put a real key in this file or anywhere else in git.
# 這個 repo 是公開的：真實金鑰絕對不要寫進這個檔案或任何會被 git 追蹤的地方。
#
# Every key is free. A missing key only skips the checks that need it.
# 以下金鑰都免費；沒填的話，只會略過需要它的檢查項目。

# Alpha Vantage (US prices, primary). Free key: https://www.alphavantage.co/support/#api-key
# Without it the script falls back to the public "demo" key, which serves only sample symbols.
ALPHAVANTAGE_API_KEY=

# FinMind (Taiwan prices and financials). Token: sign in at https://finmindtrade.com/ and open the user info page.
# Optional: it raises the hourly quota (PRD Section 6: 600 requests/hour with a token).
FINMIND_TOKEN=

# FRED (US 10-year yield, TWD/USD). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Optional: without it the script uses FRED's keyless CSV download.
FRED_API_KEY=

# Financial Modeling Prep. Optional: only used to test whether it can price LSE-listed AGGU.
FMP_API_KEY=

# Taiwan Ministry of Environment open data (penalty records). Free member key: https://data.moenv.gov.tw/
MOENV_API_KEY=

# SEC EDGAR asks every program to identify itself with a contact email in its User-Agent.
# SEC 要求程式在 User-Agent 裡寫明名稱與聯絡 email，例如：LongViewInvest your-email@example.com
SEC_USER_AGENT=

# Supabase project (Phase 1, step 2; see docs/supabase-setup.md). Both values are public by design:
# the publishable key only lets a browser start a sign-in, and row-level security keeps every table
# closed to anyone but the owner. The secret key (sb_secret_...) and the database password never go here.
# Supabase 專案網址與 publishable key 都是公開值；secret key 與資料庫密碼絕對不要放在這裡。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
